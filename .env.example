# Copy this file to .env.local, then fill in the values:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real secrets.

# ---- Supabase (Project Settings > API) --------------------------------------
# Public values. Safe to ship to the browser; RLS still applies to every query.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS, so never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Bank detail encryption (server only) -----------------------------------
# 32 byte AES-256-GCM key. Generate one with: npm run key:generate
BANK_ENCRYPTION_KEY=
# Optional. Set during a key rotation so old rows still decrypt.
BANK_ENCRYPTION_KEY_PREVIOUS=

# ---- Anthropic Claude (server only) -----------------------------------------
# Used for order screenshot extraction. Without a key, uploads still work and
# the user simply types the details in themselves on the confirm screen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- SMS provider (server only) ---------------------------------------------
# Used to deliver the phone verification code. Point SMS_PROVIDER_URL at a
# vendor that accepts POST { to, body, sender } with a bearer token, or
# implement SmsProvider in src/lib/sms/provider.ts for a different shape.
#
# With no provider configured, development prints the code to the server
# console (never to an API response), and production REFUSES to issue a code at
# all - so a missing credential can never silently disable phone verification.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# ---- Phone verification codes (server only) ---------------------------------
# Optional pepper for the stored code hashes. When unset, a domain-separated
# derivation of BANK_ENCRYPTION_KEY is used, so no extra secret is required.
OTP_HASH_PEPPER=
# How long a code stays valid, and how many wrong guesses it tolerates.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Signed URL lifetimes, in seconds ---------------------------------------
SIGNED_URL_TTL_SCREENSHOT=3600
SIGNED_URL_TTL_SHARE=86400

# ---- Rate limiting ----------------------------------------------------------
# Optional. When both are set, Upstash Redis is used for rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# With neither set, the limiter uses the durable Postgres store added in
# migration 0006 (public.consume_rate_limit). That store is shared across
# Cloudflare isolates, so it is a real limit in production - do not rely on the
# per-instance in-memory fallback, which is only reached if the database store
# is unreachable.

# ---- Optional: local debugging ----------------------------------------------
# Set to 1 to include driver error messages in server logs. Leave empty in production.
LOG_ERROR_MESSAGES=
